# GDA CMEK enforcement framework validation — single source of truth.
# Sourced by Bash (scripts/*.sh, layer*/deploy.sh, tests/run_*.sh) and loaded by
# Python (config/_loader.py).
#
# Convention:
#   - Project-identity values below are PLACEHOLDERS — fill them in via
#     config/shared.env.local (gitignored), which is layered on top of this file
#     at load time. .local values win for any key they set.
#   - Everything else is a reference-architecture default that works as-is.

# === Fill these in via shared.env.local ===

# --- Workload project: GDA agents, approved KMS key, Layer 4 + Layer 5 infra ---
PROJECT_ID=your-gda-workload-project
PROJECT_NUMBER=000000000000

# --- Unapproved KMS key project (proves restrictCmekCryptoKeyProjects equivalence) ---
ROGUE_PROJECT_ID=your-rogue-kms-project

# --- Credentials pinning (optional; empty = use ambient ADC) ---
# GCP_CREDENTIALS_FILE: path to a service-account or user-cred JSON.
# GCLOUD_CONFIG_NAME:   gcloud configuration to activate for `gcloud` subprocess
#                       calls (sets CLOUDSDK_ACTIVE_CONFIG_NAME).
# NOTE: constraints/iam.disableServiceAccountKeyCreation is enforced in this org,
# so GCP_CREDENTIALS_FILE stays empty and all auth is ambient ADC.
GCP_CREDENTIALS_FILE=
GCLOUD_CONFIG_NAME=

# The same two values for the rogue KMS project. Read ONLY by
# scripts/99_teardown.sh, to clean up local state it can prove belongs to this
# estate. Leave empty if you keep no separate gcloud configuration for it —
# teardown then leaves your local gcloud state alone.
ROGUE_GCP_CREDENTIALS_FILE=
ROGUE_GCLOUD_CONFIG_NAME=

# === Sane defaults (override in shared.env.local only if you really need to) ===

# --- Location. CMEK supports only us-east4, us, eu. `global` is NOT supported. ---
LOCATION=us-east4

# --- Cloud KMS ---
KMS_KEYRING=gda-kr
KMS_KEY=agent-key
ROGUE_KMS_KEYRING=rogue-kr
ROGUE_KMS_KEY=rogue-key

# --- Compliance allowlist (mimics constraints/gcp.restrictCmekCryptoKeyProjects) ---
# Comma-separated list of KMS project IDs permitted to hold CMEK keys.
# Defaults to PROJECT_ID; set explicitly in shared.env.local.
APPROVED_KMS_PROJECTS=

# --- Layer 4: detect + auto-remediate ---
PUBSUB_TOPIC=gda-cmek-violations
LOG_SINK=gda-cmek-create-sink
FUNCTION_NAME=gda-cmek-enforcer
ENFORCER_SA=gda-cmek-enforcer

# --- Layer 5: continuous compliance ---
BQ_DATASET=gda_compliance
BQ_LOCATION=us-east4
INVENTORY_TABLE=agent_inventory
COMPLIANCE_VIEW=v_agent_compliance
SCANNER_JOB=gda-inventory-scanner
SCANNER_SA=gda-inventory-scanner
# Quoted: an unquoted cron expression is glob-expanded by `set -a; source`.
SCANNER_SCHEDULE="0 * * * *"
# Locations the scanner sweeps. `global` is included deliberately: agents there
# can never be CMEK-encrypted, so they must surface as non-compliant.
SCAN_LOCATIONS=us-east4,us,eu,global

# --- Test fixtures ---
BQ_SOURCE_DATASET=cymbal_demo
BQ_SOURCE_TABLE=customers
